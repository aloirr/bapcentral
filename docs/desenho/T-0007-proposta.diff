+/**
+ * Gravador por git push num repositório bare só do coord (na pasta do cache, fora de qualquer clone): busca o topo do
+ * ramo (ou do main, se o ramo ainda não existe) com --depth=1, monta o commit pelo encanamento do git (hash-object,
+ * índice temporário, write-tree, commit-tree) e empurra sem force. Recusa por não ser fast-forward (outro agente
+ * empurrou antes) → busca de novo e remonta. A credencial é a do git da máquina (na nuvem, o proxy); o coord não a vê.
+ * @param {{git: Function, url: string, ramo: string, pasta: string, principal?: string, tentativas?: number, esperar?: Function}} p
+ */
+export function criarGravadorGit({ git, url, ramo, pasta, principal = BRANCH_RECADOS, tentativas = 6, esperar = dormir }) {
+  const g = (args, o) => git(['--git-dir', pasta, ...args], o);
+  const ok = (args, o) => {
+    const r = g(args, o);
+    if (r.codigo !== 0) throw new ErroRecados(`git ${args[0]} falhou: ${limparSaidaDoGit(r.erro) || `saída ${r.codigo}`}`, { rede: true });
+    return r.saida.trim();
+  };
+  function preparar() { // dentro da trava: dois coord ao mesmo tempo não criam o bare juntos
+    if (existsSync(join(pasta, 'HEAD'))) return;
+    const r = git(['init', '--bare', '-q', pasta]);
+    if (r.codigo !== 0) throw new ErroRecados(`git init falhou: ${limparSaidaDoGit(r.erro)}`);
+  }
+  /** {ramo: oid|null, principal: oid|null} no GitHub agora. */
+  function topos() {
+    const out = ok(['ls-remote', url, `refs/heads/${ramo}`, `refs/heads/${principal}`]);
+    const t = { ramo: null, principal: null };
+    for (const l of out.split('\n')) {
+      const [oid, ref] = l.trim().split(/\s+/);
+      if (ref === `refs/heads/${ramo}`) t.ramo = oid;
+      if (ref === `refs/heads/${principal}`) t.principal = oid;
+    }
+    return t;
+  }
+  /** Leitura da base (o commit de onde o novo sai): ids dos recados e texto de um caminho. */
+  function leitor(base) {
+    const nomes = ok(['ls-tree', '-r', '--name-only', base, '--', 'recados']).split('\n').filter(Boolean);
+    const existentes = new Set(nomes);
+    return {
+      ids: new Set(nomes.filter((n) => /^recados\/(?!anexos\/)[^/]+\/[^/]+\.md$/i.test(n)).map((n) => n.replace(/^.*\/|\.md$/gi, ''))),
+      existe: (c) => existentes.has(c),
+      texto(c) { const r = g(['cat-file', 'blob', `${base}:${c}`]); return r.codigo === 0 ? r.saida : null; },
+    };
+  }
+  const assinar = () => g(['config', '--bool', 'commit.gpgsign']).saida.trim() === 'true';
+  const identidade = () => (g(['config', 'user.email']).saida.trim() ? {} : {
+    GIT_AUTHOR_NAME: 'bap-coord', GIT_AUTHOR_EMAIL: 'bap-coord@users.noreply.github.com',
+    GIT_COMMITTER_NAME: 'bap-coord', GIT_COMMITTER_EMAIL: 'bap-coord@users.noreply.github.com',
+  });
+
+  /** Um commit com os arquivos sobre a base (atômico); null se não há o que gravar. */
+  function montarCommit(base, arquivos, mensagem) {
+    const indice = join(pasta, `indice-${process.pid}`);
+    const env = { GIT_INDEX_FILE: indice };
+    try {
+      ok(['read-tree', base], { env });
+      for (const a of arquivos) {
+        const buf = Buffer.isBuffer(a.conteudo) ? a.conteudo : Buffer.from(String(a.conteudo), 'utf8');
+        const blob = ok(['hash-object', '-w', '--stdin'], { entrada: buf });
+        if (blob !== shaDoBlob(buf)) throw new ErroRecados('o git devolveu um blob diferente do enviado');
+        ok(['update-index', '--add', '--cacheinfo', `100644,${blob},${a.caminho}`], { env });
+      }
+      const arvore = ok(['write-tree'], { env });
+      return ok(['commit-tree', arvore, '-p', base, ...(assinar() ? ['-S'] : []), '-F', '-'], { entrada: mensagem, env: identidade() });
+    } finally { try { rmSync(indice, { force: true }); } catch { /* ok */ } }
+  }
+
+  return {
+    ramo,
+    /**
+     * Grava no ramo. `montar(leitor)` → {arquivos: [{caminho, conteudo}], titulo, corpo?} ou null (nada a gravar);
+     * é chamado de novo a cada tentativa, sobre a base nova. → {oid, ramo, tentativas} | null.
+     */
+    publicar(montar) {
+      mkdirSync(pasta, { recursive: true });
+      return comTrava(join(pasta, 'bap-coord.lock'), () => {
+        preparar();
+        let ultimo = null;
+        for (let t = 1; t <= tentativas; t++) {
+          const tp = topos();
+          const ref = tp.ramo ? ramo : principal;
+          if (!tp.ramo && !tp.principal) throw new ErroRecados(`o ${principal} do repositório de recados não foi encontrado pelo git`);
+          ok(['fetch', '-q', '--no-tags', '--depth=1', url, `+refs/heads/${ref}:refs/bap/base`]);
+          const base = ok(['rev-parse', 'refs/bap/base^{commit}']);
+          const plano = montar(leitor(base));
+          if (!plano || !plano.arquivos.length) return null;
+          const commit = montarCommit(base, plano.arquivos, plano.corpo ? `${plano.titulo}\n\n${plano.corpo}\n` : `${plano.titulo}\n`);
+          const r = g(['-c', 'push.negotiate=false', 'push', '--porcelain', '--no-verify', url, `${commit}:refs/heads/${ramo}`]);
+          if (r.codigo === 0) return { oid: commit, ramo, tentativas: t };
+          // outro push chegou antes: recusa no cliente (non-fast-forward) ou no servidor (a ref mudou entre o anúncio e a gravação)
+          const recusado = /\[rejected\]|non-fast-forward|fetch first|stale info|cannot lock ref|incorrect old value|failed to update ref/i.test(`${r.saida}\n${r.erro}`);
+          if (!recusado) {
+            // resposta perdida? confere o topo do ramo antes de dizer que falhou
+            let agora = null;
+            try { agora = topos().ramo; } catch { /* abaixo */ }
+            if (agora === commit) return { oid: commit, ramo, tentativas: t, conferido: true };
+            const negado = /\b403\b|not permitted|denied|permission/i.test(r.erro);
+            const dica = negado && ramo === principal ? ' (se a Action integrar-recados.yml já estiver no repositório de recados, defina BAP_RECADOS_RAMO=claude/<sessão>)' : '';
+            throw new ErroRecados(`o git push para o ${ramo} foi ${negado ? 'negado' : 'recusado'}: ${limparSaidaDoGit(r.erro) || `saída ${r.codigo}`}${dica}`, { rede: !negado, proxy: negado });
+          }
+          ultimo = limparSaidaDoGit(r.saida || r.erro);
+          esperar(250 * t + Math.floor(Math.random() * 500));
+        }
+        throw new ErroRecados(`o ramo ${ramo} mudou ${tentativas} vezes durante a gravação${ultimo ? ` (${ultimo})` : ''}; nada foi gravado. Tente de novo`);
+      });
+    },
+  };
+}
