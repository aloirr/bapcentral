+/** Espera o caminho aparecer no main com o blob certo (a Action integrou). → true | false (prazo esgotado). */
+export function esperarNoMain({ cliente, caminho, blob, prazoMs = 120_000, passoMs = 5_000, esperar = dormir, agora = Date.now }) {
+  const fim = agora() + prazoMs;
+  for (;;) {
+    try { const r = cliente.arquivo(caminho); if (r.existe && r.blob === blob) return true; } catch (e) { if (!(e instanceof ErroRecados)) throw e; }
+    if (agora() + passoMs > fim) return false;
+    esperar(passoMs);
+  }
+}
