@@ -0,0 +1,53 @@
+# Integra no main os recados e lidos que o coord.mjs grava no ramo da sessão da nuvem (T-0007 do aloirr/bapcentral).
+# Na nuvem do claude.ai/code o proxy só deixa empurrar o ramo claude/<sessão>; este workflow leva para o main.
+# O script vem do checkout do main (nunca do ramo). Só acrescenta (recado novo válido, linhas de lidos).
+# O push feito com o GITHUB_TOKEN não dispara outros workflows: o aviso do Telegram roda aqui mesmo.
+name: integrar recados da sessão
+
+on:
+  push:
+    branches: ['claude/**']
+  schedule:
+    - cron: '23 11-23 * * 1-5' # varredura de hora em hora, 7h às 19h de Manaus, seg a sex (lidos e runs cancelados)
+  workflow_dispatch:
+
+permissions: {}
+
+# Um run por ramo; o run pendente que a fila cancela não perde nada (o próximo olha a árvore inteira do ramo).
+# Não use o grupo escrita-no-main: lá um run pendente do formulário seria cancelado. A corrida no push ao main
+# se resolve com a nova tentativa do script.
+concurrency:
+  group: integrar-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  integrar:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+          fetch-depth: 1
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+
+      - name: integrar no main
+        id: integrar
+        env:
+          RAMO: ${{ github.event_name == 'push' && github.ref_name || '' }}
+        run: node .github/scripts/integrar-recados.mjs "$RAMO"
+
+      - name: aviso no Telegram dos recados integrados para o alexandre
+        if: vars.TELEGRAM_LIGADO == 'sim' && steps.integrar.outputs.integrados != '' && steps.integrar.outputs.integrados != '0'
+        env:
+          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
+          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
+          ANTES: ${{ steps.integrar.outputs.antes }}
+          DEPOIS: ${{ steps.integrar.outputs.depois }}
+          REPO_URL: ${{ github.server_url }}/${{ github.repository }}
+        run: node .github/scripts/aviso-telegram.mjs
