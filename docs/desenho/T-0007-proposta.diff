+/** Remetentes que só o servidor grava (ADR 0043 do repositório de código): o ramo nunca traz recado deles. */
+export const REMETENTES_DE_SISTEMA = ['diagnostico'];
+export const LIMITE_RECADO = 256 * 1024;
+const RE_RECADO_DO_RAMO = new RegExp(`^recados/([a-z-]+)/(${PADRAO_ID})\\.md$`);
+const RE_LIDOS_DO_RAMO = /^lidos\/([a-z-]+)\.txt$/;
+const RE_LINHA_DE_LIDO = new RegExp(`^${PADRAO_ID}$`);
+const listaDoCabecalho = (v) => String(v || '').replace(/^\[|\]$/g, '').split(',').map((s) => s.trim()).filter(Boolean);
