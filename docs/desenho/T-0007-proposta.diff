+/** Linhas de vários textos, sem repetir, na ordem em que aparecem (o main primeiro). Igual ao unirLinhas da coord-lib. */
+export function unirLinhas(...textos) {
+  const vistas = new Set();
+  for (const t of textos) for (const l of String(t || '').split(/\r?\n/)) if (l.trim()) vistas.add(l.trim());
+  return [...vistas];
+}
+
+/** Motivo para não integrar o recado do ramo (null = vale): caminho, cabeçalho, remetente e destino conferidos. */
+export function motivoParaRecusarRecado(caminho, texto) {
+  const m = caminho.match(RE_RECADO_DO_RAMO);
+  if (!m) return 'caminho fora do padrão recados/<destino>/<id>.md';
+  const [, destino, id] = m;
+  if (!DESTINOS.includes(destino)) return `destino desconhecido: ${destino}`;
+  if (Buffer.byteLength(texto, 'utf8') > LIMITE_RECADO) return 'recado maior que 256 KB';
+  const r = lerRecado(texto);
+  if (!r) return 'sem o cabeçalho do recado';
+  const de = remetenteDoId(id);
+  if (r.meta.id !== id) return 'o id do cabeçalho não bate com o nome do arquivo';
+  if (r.meta.de !== de) return 'o remetente do cabeçalho não bate com o id';
+  if (REMETENTES_DE_SISTEMA.includes(de)) return `remetente de sistema (${de}) só o servidor grava`;
+  if (![...AGENTES, 'alexandre'].includes(de)) return `remetente desconhecido: ${de}`;
+  if (!TIPOS.includes(r.meta.tipo)) return `tipo inválido: ${r.meta.tipo}`;
+  if (![...listaDoCabecalho(r.meta.para), ...listaDoCabecalho(r.meta.cc)].includes(destino)) return 'o destino da pasta não está no para nem no cc';
+  return null;
+}
+
+/**
+ * O que integrar do ramo no main (função pura, idempotente): `doRamo` e `doMain` = {caminho: texto} de recados/ e lidos/.
+ * - recado novo e válido → recados; igual ao do main → iguais; mesmo caminho com outro texto → recusado (imutável);
+ * - lidos/<destino>.txt → texto do main + linhas do ramo que faltam (ids válidos), só se mudou;
+ * - o resto (anexos, outros caminhos, arquivo do main que o ramo não tem) não entra e não apaga nada.
+ * @returns {{recados: {caminho: string, texto: string}[], lidos: {caminho: string, texto: string}[], recusados: {caminho: string, motivo: string}[], iguais: number}}
+ */
+export function planejarIntegracao({ doRamo, doMain }) {
+  const plano = { recados: [], lidos: [], recusados: [], iguais: 0 };
+  for (const caminho of Object.keys(doRamo).sort()) {
+    const texto = doRamo[caminho];
+    if (caminho.startsWith('recados/') && !caminho.startsWith('recados/anexos/')) {
+      if (doMain[caminho] !== undefined) {
+        if (doMain[caminho] === texto) plano.iguais++;
+        else plano.recusados.push({ caminho, motivo: 'já existe no main com outro texto (recado é imutável)' });
+        continue;
+      }
+      const motivo = motivoParaRecusarRecado(caminho, texto);
+      if (motivo) plano.recusados.push({ caminho, motivo }); else plano.recados.push({ caminho, texto });
+      continue;
+    }
+    const l = caminho.match(RE_LIDOS_DO_RAMO);
+    if (!l) continue;
+    if (!DESTINOS.includes(l[1])) { plano.recusados.push({ caminho, motivo: `lidos de destino desconhecido: ${l[1]}` }); continue; }
+    const doRamoValidas = unirLinhas(texto).filter((x) => RE_LINHA_DE_LIDO.test(x));
+    const atuais = unirLinhas(doMain[caminho]);
+    const juntas = unirLinhas(atuais.join('\n'), doRamoValidas.join('\n'));
+    if (juntas.length > atuais.length) plano.lidos.push({ caminho, texto: `${juntas.join('\n')}\n` });
+  }
+  return plano;
+}
