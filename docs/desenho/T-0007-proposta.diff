+/**
+ * Marca lidos pelo git (T-0007): lidos/<agente>.txt do ramo = linhas do main + as do ramo + as novas (sem repetir).
+ * Não espera a integração: a caixa da sessão já une os lidos do ramo (lidosDoRamo). → {novos, commit?}.
+ */
+export function marcarLidosPorGit({ cliente, gravador, agente, ids }) {
+  const caminho = `lidos/${agente}.txt`;
+  const doMain = cliente.arquivo(caminho).texto || '';
+  let novos = [];
+  const commit = gravador.publicar((base) => {
+    const noRamo = base.texto(caminho) || '';
+    const atuais = new Set(unirLinhas(doMain, noRamo));
+    novos = [...new Set(ids)].filter((i) => !atuais.has(i));
+    if (!novos.length) return null;
+    return { arquivos: [{ caminho, conteudo: `${unirLinhas(doMain, noRamo, novos.join('\n')).join('\n')}\n` }], titulo: `lidos: ${agente} (${novos.length})` };
+  });
+  return commit ? { novos, commit } : { novos };
+}
