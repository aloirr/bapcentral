+  let ramos = process.argv.slice(2).filter(Boolean);
+  if (!ramos.length) {
+    ramos = git('ls-remote', '--heads', 'origin', 'refs/heads/claude/*').split('\n').filter(Boolean).map((l) => l.split('\t')[1].replace(/^refs\/heads\//, ''));
+  }
+  ramos = ramos.filter((r) => /^claude\/[A-Za-z0-9._-]+$/.test(r));
+  if (!ramos.length) { console.log('nenhum ramo claude/** para integrar'); process.exit(0); }
+  git('config', 'user.name', 'github-actions[bot]');
+  git('config', 'user.email', '41898282+github-actions[bot]@users.noreply.github.com');
+  for (let t = 1; t <= 5; t++) {
+    git('fetch', '-q', '--no-tags', '--depth=1', 'origin', '+refs/heads/main:refs/remotes/origin/main', ...ramos.map((r) => `+refs/heads/${r}:refs/remotes/origin/${r}`));
+    git('reset', '-q', '--hard', 'origin/main');
+    const antes = git('rev-parse', 'HEAD').trim();
+    let nRec = 0; let nLid = 0;
+    for (const ramo of ramos) {
+      const p = planoDoRamo(`refs/remotes/origin/${ramo}`);
+      for (const x of p.recusados) console.log(`::warning::${ramo}: ${x.caminho} NÃO integrado: ${x.motivo}`);
+      for (const x of [...p.recados, ...p.lidos]) {
+        mkdirSync(dirname(x.caminho), { recursive: true });
+        writeFileSync(x.caminho, x.texto);
+        git('add', '--', x.caminho);
+      }
+      nRec += p.recados.length; nLid += p.lidos.length;
+      console.log(`${ramo}: ${p.recados.length} recado(s) novo(s), ${p.lidos.length} arquivo(s) de lidos, ${p.iguais} já no main, ${p.recusados.length} recusado(s)`);
+    }
+    if (!nRec && !nLid) { console.log('nada a integrar'); process.exit(0); }
+    git('commit', '-q', '-m', `recados: integra ${nRec} recado(s) e ${nLid} lido(s) de ${ramos.join(', ')}`);
+    try {
+      git('push', '-q', 'origin', 'HEAD:main');
+      saida('antes', antes); saida('depois', git('rev-parse', 'HEAD').trim()); saida('integrados', String(nRec));
+      console.log('integrado no main');
+      process.exit(0);
+    } catch { dormir(t * 3); }
+  }
+  console.log('::error::push ao main recusado 5 vezes');
+  process.exit(1);
+}
