+ * "enviado" só com o recado no main (integrado: true); com o prazo esgotado, integrado: false (gravado no ramo).
+ * @returns {{id: string, commit: {oid: string, ramo: string}, integrado: boolean}}
+ */
+export function enviarRecadoPorGit({ cliente, cache, gravador, de, destinos, gerarId, montar, respondeA = null, prazoMs = 120_000, esperar = dormir }) {
+  const idx = atualizarIndiceDeRecados({ cliente, cache, exigirOnline: true });
