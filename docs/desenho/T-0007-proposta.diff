+// Integra no main os recados e lidos gravados pelo coord.mjs no ramo da sessão da nuvem (T-0007 do aloirr/bapcentral).
+// Uso (no checkout do main, workflow integrar-recados.yml): node .github/scripts/integrar-recados.mjs [ramo ...]
+//   sem ramo (varredura agendada): todos os claude/** do origin.
+// Idempotente: olha a árvore inteira do topo de cada ramo (não o diff do push), então um run cancelado na fila não
+// perde nada — o próximo integra tudo. Só acrescenta: recado novo válido e linhas de lidos; nunca apaga nem
+// sobrescreve. Não imprime o texto dos recados (só caminho e motivo). Saídas (GITHUB_OUTPUT): antes, depois, integrados.
+import { execFileSync } from 'node:child_process';
+import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { planejarIntegracao } from './recados-lib.mjs';
+
+const git = (...a) => execFileSync('git', ['-c', 'core.quotepath=off', ...a], { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
+const ehDoIndice = (p) => /^recados\/(?!anexos\/)[^/]+\/[^/]+\.md$/.test(p) || /^lidos\/[^/]+\.txt$/.test(p);
+const dormir = (s) => execFileSync('sleep', [String(s)]);
+
+/** {caminho: oid} de recados/ e lidos/ num commit. */
+export function blobsDe(ref, rodar = git) {
+  const r = {};
+  for (const e of rodar('ls-tree', '-r', '-z', ref, '--', 'recados', 'lidos').split('\0').filter(Boolean)) {
+    const [info, caminho] = e.split('\t');
+    const [, tipo, oid] = info.split(' ');
+    if (tipo === 'blob' && ehDoIndice(caminho)) r[caminho] = oid;
+  }
+  return r;
+}
+
+/** Plano de um ramo contra o HEAD (main): só os caminhos com blob diferente viram texto. */
+export function planoDoRamo(ref, rodar = git) {
+  const doMainOid = blobsDe('HEAD', rodar);
+  const doRamoOid = blobsDe(ref, rodar);
+  const doRamo = {};
+  const doMain = {};
+  for (const [c, oid] of Object.entries(doRamoOid)) {
+    if (doMainOid[c] === oid) continue;
+    doRamo[c] = rodar('cat-file', 'blob', oid);
+    if (doMainOid[c]) doMain[c] = rodar('cat-file', 'blob', doMainOid[c]);
+  }
+  return planejarIntegracao({ doRamo, doMain });
+}
+
+const saida = (k, v) => { if (process.env.GITHUB_OUTPUT) appendFileSync(process.env.GITHUB_OUTPUT, `${k}=${v}\n`); };
+
