+
+  # T-0045 (ADR 0004; contrato .coord/contratos/visitas-nuvem.md v1): visitas da Máxima.
+  # Cron job à parte (D1 da ADR 0004): acorda de 10 em 10 min,
+  # pergunta ao site se há trabalho (agenda das 06h00, botão, diagnóstico, teto do dia) e sai.
+  # A senha da Máxima fica SÓ aqui, nunca no bap-central.
+  - type: cron
+    name: bap-visitas-maxima
+    runtime: docker
+    plan: standard           # 2 GB, 1 CPU, pago pelo tempo rodado [SUPOSIÇÃO: preço em docs/desenho/T-0045-render-yaml.md, §2.1]
+    region: oregon           # a mesma do bap-central (rede privada)
+    schedule: "*/10 10-23,0-1 * * *"   # UTC: de 10 em 10 min, das 06h00 às 21h50 de Manaus (UTC-4)
+    dockerfilePath: ./nuvem/visitas/Dockerfile
+    dockerContext: .
+    autoDeploy: true
+    buildFilter:             # só refaz a imagem quando o código dela muda
+      paths:
+        - nuvem/visitas/**
+        - visitas_maxima.py
+        - visitas_nucleo.py
+        - requirements-visitas.txt
+    envVars:
+      - key: TZ
+        value: America/Manaus
+      - key: PYTHONUNBUFFERED
+        value: "1"
+      - key: BAP_WEB_HOSTPORT
+        fromService:
+          type: web
+          name: bap-central
+          property: hostport
+      - key: BAP_VISITAS_TOKEN
+        fromService:         # o valor sorteado no bap-central [SUPOSIÇÃO: envVarKey aceito no cron]
+          type: web
+          name: bap-central
+          envVarKey: BAP_VISITAS_TOKEN
+      - key: BAP_MAXIMA_USUARIO
+        sync: false          # o Alexandre cria no painel (usuário próprio do robô, D4); preencher no mesmo sync
+      - key: BAP_MAXIMA_SENHA
+        sync: false          # o Alexandre cria no painel; só neste serviço
